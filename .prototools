moon = "2.5.5"
node = "22"            # matches setup-node '22' in both workflows today
npm = "10.9.7"         # version bundled with Node 22 today; no prior pin existed to match
terraform = "1.15.8"   # matches setup-terraform and every providers.tf required_version

[plugins]
# Third-party proto plugin, pinned to a commit SHA rather than a branch. It verifies checksums on
# download (checksum-url is set for every platform).
terraform = "https://raw.githubusercontent.com/theomessin/proto-toml-plugins/b0f45e8bcc34310db680828cab62850328964996/terraform.toml"

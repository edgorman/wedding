// The Worker that serves the site: dist/ as static assets, with worker/index.js in front of them.
// `name` is for local use; `wrangler deploy --name` names the real Worker, so one bundle serves
// every environment. Terraform (infrastructure/root/cloudflare_workers.tf) creates the Worker and
// its domains; wrangler uploads versions.
{
  "name": "app",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // The site is one page: unknown paths get it instead of a 404.
    "not_found_handling": "single-page-application",
    // The Worker sees every request, so it can mark non-production hosts noindex and serve
    // robots.txt and the sitemap before the assets do.
    "run_worker_first": true
  }
}
